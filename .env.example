# The Dispatch — environment variables.
# Copy to .env.local for local dev. Never commit real values.
# Set the same keys in Vercel (Production + Preview) and redeploy after changes.

# --- Database (Phase 1) -------------------------------------------------------
# Neon *pooled* connection string, region AWS Asia Pacific (Singapore),
# matching the Vercel function region sin1 in vercel.json.
DATABASE_URL=

# --- Gemini (Phase 4) ---------------------------------------------------------
GEMINI_API_KEY=
# Read from env, never hardcoded. gemini-3.8-flash was overloaded (503) on 2026-10-12; 3.6 is the other stable Flash.
GEMINI_MODEL=gemini-3.6-flash
# true = return tests/fixtures JSON instead of calling Gemini (tests, offline dev).
GEMINI_MOCK=false

# --- GNews (Phase 2) ----------------------------------------------------------
NEWS_API_KEY=

# --- Telegram (Phase 6) -------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Random string, 1-256 chars of A-Z a-z 0-9 _ -. Telegram echoes it as a header.
TELEGRAM_WEBHOOK_SECRET=
# Numeric ids; the bot tells you yours when you send /start.
SHREYA_TG_USER_ID=
SHREYA_TG_CHAT_ID=

# --- Email (Phase 7) ----------------------------------------------------------
RESEND_API_KEY=
# Svix signing secret from the Resend webhook settings page.
RESEND_WEBHOOK_SECRET=
MAIL_FROM="The Dispatch <onboarding@resend.dev>"
MAIL_REPLY_TO=
# Comma-separated addresses that may receive real mail while DEMO_MODE=true.
SEND_ALLOWLIST=
# Defaults to true when unset: only SEND_ALLOWLIST gets real mail, the rest
# are logged as skipped_demo. Must be the literal string false to disable.
DEMO_MODE=true

# --- Auth / signing (generate long random values) -----------------------------
# Vercel sends "Authorization: Bearer <CRON_SECRET>" to cron routes. 16+ chars.
CRON_SECRET=
# Protects /api/admin/* and the dashboard's Run-now buttons. 16+ chars.
ADMIN_TOKEN=
# HMAC key for unsubscribe links. 32+ chars. Rotating it breaks old links.
UNSUB_SIGNING_KEY=

# --- App ----------------------------------------------------------------------
# Public base URL, e.g. https://the-dispatch.vercel.app
APP_URL=
