{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "0 3 * * 1-3"
    },
    {
      "path": "/api/cron/ingest?slot=precurate",
      "schedule": "0 8 * * 3"
    },
    {
      "path": "/api/cron/curate",
      "schedule": "0 9 * * 3"
    },
    {
      "path": "/api/cron/notify",
      "schedule": "0 12 * * 3"
    },
    {
      "path": "/api/cron/remind?check=1",
      "schedule": "0 16 * * 3"
    },
    {
      "path": "/api/cron/remind?check=2",
      "schedule": "0 17 * * 3"
    },
    {
      "path": "/api/cron/send",
      "schedule": "0 2 * * 4"
    }
  ]
}
